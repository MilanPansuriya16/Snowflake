--Create Database
CREATE DATABASE HOTEL_DB;

--Create File Format
CREATE OR REPLACE FILE FORMAT FF_CSV
    TYPE = 'CSV'
    FIELD_OPTIONALLY_ENCLOSED_BY = '"'
    SKIP_HEADER = 1
    NULL_IF = ('NULL','null','')

--Create Stage
CREATE OR REPLACE STAGE STG_HOTEL_BOOKINGS
    FILE_FORMAT = FF_CSV;

--------------------------------------------------------------------------------------------------------------------------------

--Create Bronze layer Table
CREATE TABLE BRONZE_HOTEL_BOOKING
(
	  booking_id		  STRING	
	, hotel_id            STRING
	, hotel_city          STRING
	, customer_id         STRING
	, customer_name       STRING
	, customer_email      STRING
	, check_in_date       STRING
	, check_out_date      STRING
	, room_type           STRING
	, num_guests          STRING
	, total_amount        STRING
	, currency            STRING
	, booking_status      STRING
)

--List the stage files
LIST @STG_HOTEL_BOOKINGS

--------------------------------------------------------------------------------------------------------------------------------

--Loading data from stage to Bronze tVARIABLES
COPY INTO BRONZE_HOTEL_BOOKING
FROM @STG_HOTEL_BOOKINGS
FILE_FORMAT = (FORMAT_NAME = FF_CSV)
ON_ERROR = 'CONTINUE';

SELECT TOP 20 * FROM BRONZE_HOTEL_BOOKING;

--------------------------------------------------------------------------------------------------------------------------------
-- Checking for errors
SELECT customer_email,* FROM BRONZE_HOTEL_BOOKING WHERE customer_email IS NULL OR customer_email NOT LIKE '%@%.%';

SELECT CHECK_IN_DATE,CHECK_OUT_DATE,* FROM BRONZE_HOTEL_BOOKING WHERE TRY_TO_DATE(CHECK_IN_DATE) IS NULL OR TRY_TO_DATE(CHECK_OUT_DATE) IS NULL;

SELECT TOTAL_AMOUNT FROM BRONZE_HOTEL_BOOKING WHERE TRY_TO_NUMBER(TOTAL_AMOUNT) < 0;

SELECT check_in_date,check_out_date,* FROM BRONZE_HOTEL_BOOKING WHERE TRY_TO_DATE(check_out_date) < TRY_TO_DATE(check_in_date);

SELECT DISTINCT booking_status FROM BRONZE_HOTEL_BOOKING;

--------------------------------------------------------------------------------------------------------------------------------
--Create Sliver Layer Table
CREATE OR REPLACE TABLE SILVER_HOTEL_BOOKINGS
(
	  booking_id		  VARCHAR	
	, hotel_id            INT
	, hotel_city          VARCHAR
	, customer_id         VARCHAR
	, customer_name       VARCHAR
	, customer_email      VARCHAR
	, check_in_date       DATETIME
	, check_out_date      DATETIME
	, room_type           VARCHAR
	, num_guests          INT
	, total_amount        FLOAT
	, currency            VARCHAR
	, booking_status      VARCHAR
)

--INITCAP() - Initial Capitalization Function
--INITCAP() converts the first letter of each word to uppercase and the rest to lowercase.

--Inserting Cleaned Data to Silver layer
INSERT INTO SILVER_HOTEL_BOOKINGS
(
	  booking_id		
	, hotel_id         
	, hotel_city       
	, customer_id      
	, customer_name    
	, customer_email   
	, check_in_date    
	, check_out_date   
	, room_type        
	, num_guests       
	, total_amount     
	, currency         
	, booking_status   
)
SELECT 
	  booking_id                                                                               					booking_id		
	, hotel_id                                                                                 					hotel_id         
	, INITCAP(TRIM(hotel_city))                                                                					hotel_city       
	, customer_id                                                                              					customer_id      
	, INITCAP(TRIM(customer_name))                                                             					customer_name    
	, CASE WHEN customer_email LIKE '%@%.%' THEN LOWER(TRIM(customer_email)) ELSE NULL END AS  					customer_email   
	, TRY_TO_DATE(NULLIF(check_in_date,''))                                                    					check_in_date    
	, TRY_TO_DATE(NULLIF(check_out_date,''))                                                   					check_out_date   
	, room_type                                                                                					room_type        
	, num_guests                                                                               					num_guests       
	, ABS(TRY_TO_NUMBER(total_amount))                                                         					total_amount     
	, currency                                                                                 					currency         
	, CASE WHEN LOWER(booking_status) IN ('confirmeeed','confirmd') THEN 'Confirmed' ELSE booking_status END AS booking_status  
FROM BRONZE_HOTEL_BOOKING
WHERE 
    TRY_TO_DATE(check_in_date) IS NOT NULL
AND
    TRY_TO_DATE(check_in_date) IS NOT NULL
AND 
    TRY_TO_DATE(check_out_date) >= TRY_TO_DATE(check_in_date);
    

SELECT TOP 20 * FROM SILVER_HOTEL_BOOKINGS;

--------------------------------------------------------------------------------------------------------------------------------
--Create Gold Tables
CREATE TABLE GOLD_AGG_DAILY_BOOKING AS
SELECT 
    check_in_date AS date,
    count(*) AS total_booking,
    SUM(total_amount) AS total_revenue
FROM SILVER_HOTEL_BOOKINGS
GROUP BY check_in_date
ORDER BY total_revenue DESC;

CREATE TABLE GOLd_AGG_HOTEL_CITY_SALES AS
SELECT  
    hotel_city,
    SUM(total_amount) AS total_revenue
FROM SILVER_HOTEL_BOOKINGS
GROUP BY hotel_city
ORDER BY total_revenue DESC;

CREATE TABLE GOLD_BOOKING_CLEAN AS 
SELECT 
      booking_id		
	, hotel_id         
	, hotel_city       
	, customer_id      
	, customer_name    
	, customer_email   
	, check_in_date    
	, check_out_date   
	, room_type        
	, num_guests       
	, total_amount     
	, currency         
	, booking_status  
FROM SILVER_HOTEL_BOOKINGS;


SELECT * FROM GOLD_BOOKING_CLEAN;
SELECT * FROM GOLD_AGG_DAILY_BOOKING;
SELECT * FROM GOLd_AGG_HOTEL_CITY_SALES;
